NODE_ENV=production
APP_NAME="Leave Management System"
PORT=4000
APP_TIMEZONE=Asia/Kolkata
PUBLIC_APP_URL=http://localhost
MONGODB_URI=mongodb://mongodb:27017/leave_management
SESSION_SECRET=replace-with-a-long-random-secret-key-at-least-32-characters
SESSION_COOKIE_NAME=lms_session
SEED_DEMO_DATA=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
